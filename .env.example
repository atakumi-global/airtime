# Airtime server configuration.

# HTTP listener
HOST=0.0.0.0
PORT=3500
LOG_LEVEL=info

# PostgreSQL connection string. In docker compose this points at the bundled
# postgres service; on a clean host without compose, point it at your own.
DATABASE_URL=postgres://airtime:airtime@localhost:3502/airtime

# Signing secrets. Generate with: openssl rand -hex 32
APP_JWT_SECRET=change-me-in-production
APP_JWT_TTL=12h
COOKIE_SECRET=change-me-in-production

# Bootstrap administrator, created on first start when the database is empty.
BOOTSTRAP_ORG_NAME=Airtime
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-production
BOOTSTRAP_ADMIN_NAME=Administrator

# Origins allowed to call the API from a browser or the desktop webview.
CORS_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:1420

# Plane token encryption at rest (v1.2). 32 bytes as 64 hex characters.
# Required to save Plane connections; generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Plane sync fallback polling. Webhooks give the fastest freshness; polling
# covers installations that do not expose webhooks.
SYNC_POLL_SECONDS=60
SYNC_POLL_ENABLED=true

# Workspace access (AIRTIME-90). A member sees and enters time on a Plane
# project only while Plane lists them as a member of it, checked with their own
# token. Before time is entered the stored permissions are compared with Plane at
# most every ACCESS_RECHECK_SECONDS. If Plane cannot be reached, the last
# verified access is trusted for ACCESS_MAX_STALE_SECONDS, then entry fails closed.
ACCESS_RECHECK_SECONDS=60
ACCESS_MAX_STALE_SECONDS=3600

# Budget projection horizon in days, used only when a Plane project has no
# target date; otherwise the project end date drives the projection.
PROJECTION_HORIZON_DAYS=30

# Daily FX rates. Frankfurter serves European Central Bank reference rates and
# needs no API key. refresh hours of 0 disables the scheduler.
FX_PROVIDER_URL=https://api.frankfurter.dev/v1/latest
FX_REFRESH_HOURS=24

# OIDC sign-in (optional). When all four are set, /auth/oidc/login is enabled
# and reuses the same identity provider as Plane. Local accounts always work
# as a fallback.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=airtime
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback

# Public base URL of this server, used to build OIDC redirects when
# OIDC_REDIRECT_URI is not set.
# BASE_URL=http://localhost:3000
