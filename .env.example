# Airtime server configuration.

# HTTP listener
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection string. In docker compose this points at the bundled
# postgres service; on a clean host without compose, point it at your own.
DATABASE_URL=postgres://airtime:airtime@localhost:5432/airtime

# Signing secrets. Generate with: openssl rand -hex 32
APP_JWT_SECRET=change-me-in-production
APP_JWT_TTL=12h
COOKIE_SECRET=change-me-in-production

# Bootstrap administrator, created on first start when the database is empty.
BOOTSTRAP_ORG_NAME=Airtime
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-in-production
BOOTSTRAP_ADMIN_NAME=Administrator

# OIDC sign-in (optional). When all four are set, /auth/oidc/login is enabled
# and reuses the same identity provider as Plane. Local accounts always work
# as a fallback.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=airtime
# OIDC_CLIENT_SECRET=change-me
# OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback

# Public base URL of this server, used to build OIDC redirects when
# OIDC_REDIRECT_URI is not set.
# BASE_URL=http://localhost:3000
